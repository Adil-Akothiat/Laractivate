# ==============================================================================
# LARACTIVATE MASTER GITIGNORE
# ==============================================================================

# --- OS & System Files ---
.DS_Store
Thumbs.db
*.sw?
*.suo
*.pid

# --- IDEs & Editors ---
.vscode/*
!.vscode/extensions.json
.idea/
.fleet/
.nova/
.zed/
*.ntvs*
*.njsproj
*.sln
.phpactor.json
.phpunit.result.cache
.phpunit.cache/

# --- Environment & Secrets ---
# 1. Ignore the specific .env files
.env.local
.env.development
.env.production
.env.backup

# 2. Specifically target subfolder envs
server/.env
server/.env.*
client/.env
client/.env.*

# 3. Explicitly allow ALL example files
!.env.example
!client/.env.example
!server/.env.example

# 4. Other secrets
auth.json
Homestead.json
Homestead.yaml

# --- Dependencies ---
node_modules/
client/node_modules/
server/vendor/
pnpm-lock.yaml

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Build & Output ---
dist/
dist-ssr/
client/dist/
client/dist-ssr/
server/public/build/
server/public/hot/
coverage/

# --- Storage & Docker ---
docker-data/
tmp/
temp/
server/public/storage
server/storage/*.key
server/storage/pail/

# --- Laravel Specific ---
# (Uncomment the line below if you want to ignore the bootstrap cache)
# server/bootstrap/cache/*