# ==============================================================================
# 🚀 REQUIRED — DO THIS FIRST
# ==============================================================================
# Full reference for every variable below: docs/env.md
# 1) cp .env.example .env
# 2) Fill in APP_KEY and JWT_SECRET using the commands below (both are blank
#    on purpose — Laractivate can't generate them for you automatically
#    because Docker manages the .env file).

APP_NAME=Laractivate
APP_ENV=local
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
APP_DEBUG=true

# APP_KEY — encrypts sessions & sensitive data. Leave blank, then run:
#   docker-compose exec app php artisan key:generate --show
# Copy the "base64:..." output and paste it here.
APP_KEY=

# Database (defaults are pre-configured for Docker Compose — no changes needed)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laractivate_db
DB_USERNAME=root
DB_PASSWORD=root

# ==============================================================================
# 🔐 AUTHENTICATION & SECURITY (JWT / COOKIES)
# ==============================================================================

# JWT_SECRET — signs auth tokens. Without it, login will not work.
# Leave blank, then run:
#   docker-compose exec app php artisan jwt:secret --show
# Copy the generated secret and paste it here.
JWT_SECRET=

JWT_TTL=25
JWT_REFRESH_TTL=10080
JWT_BLACKLIST_ENABLED=true

COOKIE_KEY_ACCESS_TOKEN=laractivate_access_token
COOKIE_KEY_REFRESH_TOKEN=laractivate_refresh_token
COOKIE_TTL=30
BCRYPT_ROUNDS=12

# ==============================================================================
# 💳 STRIPE & BILLING — OPTIONAL, only needed if your app handles payments
# ==============================================================================
# Full walkthrough (CLI login, webhook secret, price IDs): docs/billing.md
# Skip this whole section if you don't need billing yet — everything else
# runs fine without it.

# From https://dashboard.stripe.com/test/apikeys
STRIPE_KEY=your_pk_test_...
STRIPE_SECRET=your_sk_test_...

# Captured by running `docker-compose up stripe-cli` — see docs/billing.md
STRIPE_WEBHOOK_SECRET=your_whsec_...

# Price IDs from https://dashboard.stripe.com/test/products
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Cashier / Billing settings
CASHIER_CURRENCY=usd
CASHIER_MODEL=App\Models\User
STRIPE_TEST_CLOCK_ID=clock_...

# ==============================================================================
# 📧 MAIL CONFIGURATION
# ==============================================================================
# Defaults to 'log' so you don't need real credentials for local development —
# outgoing mail is just written to the log file instead of sent.

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_SCHEME=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# ☁️ EXTERNAL INTEGRATIONS (AWS / STORAGE) — OPTIONAL
# ==============================================================================
# Only needed if you're using S3-compatible storage.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==============================================================================
# ⚙️ INTERNAL INFRASTRUCTURE & APPLICATION DRIVERS
# ==============================================================================
# Standard application defaults. Leave these untouched unless you know you
# need to change them.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# CACHE_PREFIX=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# Redis (optional infrastructure)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MEMCACHED_HOST=127.0.0.1

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Frontend interoperability
VITE_APP_NAME="${APP_NAME}"